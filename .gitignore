# Python
__pycache__/
*.pyc

# Private. These never go into the repository: the build leaves them out of the public
# package, and checks that these three lines are here.
src/references/household.md
src/scripts/data/personal.json
src/images/private/

# A second lock, in case a private copy lands here by mistake
private/
voss-private*
voss-handoff*
HANDOFF.md
*.private.*
personal.json
# calendar files carry medicine names; the tools refuse to write one here, and this is the second lock
*.ics

# Downloaded source data for the databases (each build script names its downloads)
downloads/

# Editors and the OS
.vscode/
.idea/
.DS_Store
Thumbs.db
